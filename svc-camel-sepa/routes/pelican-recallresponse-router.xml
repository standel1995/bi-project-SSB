	<route id="recallresponse" autoStartup="true">
		<from uri="direct://recallresponse" />
		<log loggingLevel="INFO" message="In recallresponse API" />
		<log loggingLevel="INFO" message="headers in recallresponse API = ${headers}"/>
		<log loggingLevel="TRACE" message="Body in recallresponse API = ${body}" />
		<removeHeaders pattern="CamelHttp*"/>
		<removeHeaders pattern="CamelNetty*"/>
		<removeHeaders pattern="Host"/>
		<setHeader headerName="CamelHttpMethod">
				<constant>POST</constant>
		</setHeader>		
		<bean ref="jspExecute" method="executeWithHazelCastInstance(${exchange},decodeRequest)" />
		<log loggingLevel="TRACE" message="body after decodeRequest = ${body}"/>
		<log loggingLevel="INFO" message="headers after setResponseCds = ${headers}"/>
		<removeHeaders pattern="ACTIVE_INSTANCE"/>
		<!-- <toD uri="sql:select t2.MESSAGE FROM MSGDB t1 JOIN MSGBLOCKS t2 ON t1.MSGDB_ID = t2.MSGDB_ID where t1.MESSAGENO = '${header.PLCN_recallId}' and MSGBLOCKTYPE = '2'?outputType=StreamList" /> -->
		<toD uri="sql:select t1.MSGDB_ID,t1.custom5,t1.CSM,t2.MESSAGE FROM MSGDB t1 JOIN MSGBLOCKS t2 ON t1.MSGDB_ID = t2.MSGDB_ID where t1.MESSAGENO = '${header.PLCN_recallId}' and MSGBLOCKTYPE = '2'?outputType=StreamList"/>
		<bean id="readMessageDb2" ref="recallUtilities" method="readMsgBlocks"/>
		<log loggingLevel="INFO" message="body after readMsgBlocks = ${body}"/>
		<log loggingLevel="INFO" message="headers after readMsgBlocks = ${headers}"/>
		<!-- <choice>
