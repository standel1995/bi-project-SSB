	<route id="g_tabledetails" autoStartup="true">
		<from uri="direct://g_tabledetails" />
		<log message="g_tabledetails started" />
		<to
			uri="sql:select TDKEY,TDVALUE from TABLEDETAILS where TDIDCODE='HZL_LD_IN'?outputType=StreamList" />
		<split streaming="true">
			<simple>${body}</simple>
			<log message="${body}"></log>
			<setHeader headerName="HZL_MAPS">
				<simple>${body[TDVALUE]}</simple>
			</setHeader>
			<to uri="direct://tabledetails" />
			<log message="Executed.." />
		</split>
	</route>

	<route>
		<from uri="direct://tabledetails" />
		<log message="tabledetails started" />
		<setHeader headerName="JS_FUNCTION_NAME">
			<constant>populateTabledetails</constant>
		</setHeader>
		<bean ref="staticDataMaps" method="getActiveMaps" />
		<to
			uri="sql:select * from TABLEDETAILS where TDIDCODE=:#TDKEY?outputType=SelectList" />
