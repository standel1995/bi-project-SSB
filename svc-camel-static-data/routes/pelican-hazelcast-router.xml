		<bean ref="staticDataMaps" method="getCompletedFlag" />
		<log loggingLevel="INFO" message="Headers in _pel_mainRoute route of static data ${headers}." />
		<choice>
			<when>
				<simple>${header.completedFlag} == false</simple>
				<log message="Starting Startup activity.." />
				<bean ref="pelicanController" method="startRoutes" />
				<to uri="direct://g_tabledetails" />
				<to uri="direct://bicplusIban" />
				<to uri="direct://instparam" />
				<to uri="direct://instHierarchy" />
				<to uri="direct://keyloadStartup" />
				<to uri="direct://clgSys" />
				<to uri="direct://populateMxClgId" />
				<to uri="direct://populateClStartTime" />
				<to uri="direct://chlHoliday" />
				<to uri="direct://langDesc" />
				<to uri="direct://chChannel" />
				<to uri="direct://accountmaster" />
				<to uri="direct://accountmasterchannel" />
				<to uri="direct://accountmastercurr" />
				<to uri="direct://queueTable" />
				<bean id="myIdemRepoReset1" ref="MyMemIdemRepo1" method="clear" />
				<to uri="controlbus://route?routeId=hazelcastFile&amp;action=start" />
				<bean id="myIdemRepoReset2" ref="MyMemIdemRepo2" method="clear" />
				<to uri="controlbus://route?routeId=mx2mxConfig&amp;action=start" />
				<to uri="controlbus://route?routeId=iprConfig&amp;action=start" />				
				<bean ref="staticDataMaps" method="setCompletedFlag" />
				<log message = "Log after setting completedFlag=true"/>
				<log message="Startup activity completed.." />
			</when>
			<otherwise>
				<log loggingLevel="DEBUG" message="Hazelcast data already loaded... " />
				<log loggingLevel="INFO" message="Hazelcast data already loaded new added statement... " />
			</otherwise>
		</choice>
	</route> 
	
	<route id="dynamicFileLoader" startupOrder="3" autoStartup="true">
	
		<from uri="timer://dynamicLoaderTimer?fixedRate=true&amp;period=1000" />
			<!-- <log loggingLevel="INFO" message="Dynamic data load router....." /> -->
			
			<setHeader headerName="inputLocation">
				<simple>file:{{file.inputLocation}}</simple>
			</setHeader>
			<setHeader headerName="backupLocation">
				<simple>file:{{file.inputLocation}}\backup</simple>
			</setHeader>
			
			<pollEnrich timeout="1000">
				<simple>file:{{file.inputLocation}}?move=backup
				</simple>
			</pollEnrich>

			<bean ref="hzlStaticFileLoader" method="getDynamicCompletedFlag" />
			
			<choice>
				<when>
					<simple>${header.dynamicCompletedFlag} == false &amp;&amp;
						${file:onlyname} == null
					</simple>
					<log loggingLevel="INFO" message="Calling Start-up route." />
					<to uri="direct:startUpRoute" />
					<bean ref="hzlStaticFileLoader"
						method="setDynamicCompletedFlag" />
					<log loggingLevel="INFO" message="Backup file inserted." />
				</when>
				<when>
					<simple>${file:onlyname} != null</simple>
					<log message="Loading CSV-${file:name}" loggingLevel="INFO" />
					<to uri="direct:fileLoaderCsv" />
					<bean ref="hzlStaticFileLoader"
						method="setDynamicCompletedFlag" />
					<log message="File loaded successfully." loggingLevel="INFO" />
				</when>
			</choice>
			<log loggingLevel="TRACE" message="Dynamic router....." />
	</route>
	
		<route id="fileLoader">
			<from uri="direct:fileLoaderCsv" />
			<bean ref="hzlStaticFileLoader"
				method="filetoHazelcastLoaderDynamic" />
			<log loggingLevel="INFO" message="file load completed" />
		</route>

		<route id="startupRoute">
			<from uri="direct:startUpRoute" />
			<log loggingLevel="INFO" message="startupRoute started..." />
			<pollEnrich timeout="1000">
				<simple>file:{{file.inputLocation}}\backup?noop=true&amp;sorter=#mySort
				</simple>
			</pollEnrich>
			<log loggingLevel="INFO" message="Moving file....${file:name} " />
			<choice>
				<when>
					<simple>${file:name} != null</simple>
					<to uri="file:{{file.inputLocation}}?fileName=${file:name}" />
				</when>
				<otherwise>
					<log loggingLevel="INFO" message="Initial start-up initiated." />
				</otherwise>
			</choice>
			
		</route>

	<route id="cron_g_tabledetails" autoStartup="true">
		<from uri="quartz2://cron_g_tabledetails?cron=0+58+15+*+*+?+*" />
