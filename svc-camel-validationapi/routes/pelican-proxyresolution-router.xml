<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
       http://camel.apache.org/schema/spring http://camel.apache.org/schema/spring/camel-spring.xsd">

	<routeContext id="proxyresolution" xmlns="http://camel.apache.org/schema/spring">	
		<route id="proxyresolutionRouter">
			<from uri="direct://proxyresolutionRouter" />
			<bean id="xmlParserproxyresolutionRouter" ref="xmlParser" />
			<bean id="jspPopulationDataProxy" ref="jspExecute" 
					method="executeWithHazelCastInstance(${exchange},proxyresolutionCheck)" />
			<log message="proxyresolution check successfully.."/>
			<!-- <log message="Headers after proxyresolution = ${headers}" />  -->
			<choice>
				<when>
					<simple>${header.PLCN_call}</simple>
					<log message="PLCN_call internal" />
				</when>
				<otherwise>
					<removeHeaders pattern="*" excludePattern="status"/>
				</otherwise>
			</choice>
		</route>
	</routeContext>	
</beans>	