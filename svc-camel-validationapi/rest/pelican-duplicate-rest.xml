<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
       http://camel.apache.org/schema/spring http://camel.apache.org/schema/spring/camel-spring.xsd">

	<restContext id="restDuplicate" xmlns="http://camel.apache.org/schema/spring">
	    <rest path="/duplicate" bindingMode="auto">
		<post>
			<route>
				<log loggingLevel="TRACE" message="Headers in restDuplicate is ${headers}" />
				<log loggingLevel="TRACE" message="Body in restDuplicate is ${body}" />
				<to uri="direct://duplicatecheckRoute"/>
				<removeHeaders pattern="ACTIVE_INSTANCE"/>
			</route>
		</post>
	</rest>
	</restContext>

</beans>