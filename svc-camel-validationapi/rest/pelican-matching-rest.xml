<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
       http://camel.apache.org/schema/spring http://camel.apache.org/schema/spring/camel-spring.xsd">

	<restContext id="restMatching" xmlns="http://camel.apache.org/schema/spring">
	    <rest path="/matching" bindingMode="auto">
			<post>
				<route>		
					<to uri="direct://matchingRouter"/>	
					<log loggingLevel="TRACE" message="Headers in restMatching = ${headers}" />
					<log loggingLevel="TRACE" message="Body in restMatching = ${body}" />
					<removeHeaders pattern="ACTIVE_INSTANCE"/>
				</route>
			</post>
		</rest>
	</restContext>

</beans>