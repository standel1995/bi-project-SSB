                </xs:annotation>
            </xs:element>
            <xs:element name="OrgnlTxId" type="TIPS_RestrictedFINXMax35Text">
                <xs:annotation>
                    <xs:documentation source="Name" xml:lang="EN">OriginalTransactionIdentification</xs:documentation>
